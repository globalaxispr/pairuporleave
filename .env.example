# Pair Up or Leave — Environment Variables Template
# Copy this file to .env and fill in your development/testing values.
# NEVER commit your real .env file or real passwords to version control.

# ====================================================
# Site & Metadata Configuration
# ====================================================
VITE_SITE_URL=https://pairuporleave.com

# ====================================================
# Client-Side Supabase Configuration (Safe for Browser)
# ====================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ====================================================
# Development-Only Demo Authentication
# WARNING: This fallback only functions when running in dev (DEV === true).
# In production builds, demo auth is statically dead code and will NEVER work.
# Set to "false" if you wish to test real Supabase auth in local development.
# ====================================================
VITE_ENABLE_DEMO_AUTH=true

# ====================================================
# Development / QA Test Admin Provisioning (Backend/CLI Only)
# Used by: npm run seed:admin
# WARNING: NEVER prefix these with VITE_ (must never reach frontend bundle).
# Keep placeholders here — supply actual values only in your local untracked .env
# ====================================================
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TEST_ADMIN_EMAIL=testadmin@pairuporleave.com
TEST_ADMIN_PASSWORD=your-secure-test-admin-password

# ====================================================
# Stripe Configuration (Edge Function Secrets Only)
# Set via: supabase secrets set STRIPE_SECRET_KEY=...
# ====================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
